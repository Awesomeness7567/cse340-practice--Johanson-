<%- include('../partials/header') %>

<main>
    <h1>Something Went Wrong</h1>

    <p>
        <%= error %>
    </p>

    <p>Current environment: <%= NODE_ENV %></p>

    <p>
        <a href="/">Return to homepage</a>
    </p>

    <% if (stack) { %>
        <details open>
            <summary>Error Details (Development Only)</summary>
            <pre><%= stack %></pre>
        </details>
    <% } %>
</main>

<%- include('../partials/footer') %>