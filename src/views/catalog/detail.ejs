<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/catalog.css">

<main>
    <div class="course-header">
        <h1>
            <%= course.courseCode %>: <%= course.name %>
        </h1>

        <p class="course-meta">
            <%= course.creditHours %> credits
        </p>

        <p class="course-description">
            <%= course.description %>
        </p>

        <p>
            <strong>Department:</strong>
            <%= course.department || course.department_name %>
        </p>
    </div>

    <div class="sections">
        <div class="sections-header">
            <h2>Available Sections</h2>

            <div class="sort-options">
                <span>Sort by: </span>

                <a
                    href="/catalog/<%= course.slug %>?sort=time"
                    class="<%= sortBy === 'time' ? 'active' : '' %>">
                    Time
                </a>

                <a
                    href="/catalog/<%= course.slug %>?sort=professor"
                    class="<%= sortBy === 'professor' ? 'active' : '' %>">
                    Professor
                </a>

                <a
                    href="/catalog/<%= course.slug %>?sort=room"
                    class="<%= sortBy === 'room' ? 'active' : '' %>">
                    Room
                </a>
            </div>
        </div>

        <div class="section-list">
            <% if (!sections || sections.length === 0) { %>
                <p>No sections are currently available for this course.</p>
            <% } else { %>
                <% sections.forEach(section => { %>
                    <div class="section-card">
                        <div class="section-time">
                            <strong>Time:</strong>
                            <%= section.time %>
                        </div>

                        <div class="section-room">
                            <strong>Room:</strong>
                            <%= section.room %>
                        </div>

                        <div class="section-professor">
                            <strong>Professor:</strong>
                            <%= section.professor %>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <div class="navigation">
        <p>
            <a href="/catalog">&larr; Back to Course Catalog</a>
        </p>
    </div>
</main>

<%- include('../partials/footer') %>