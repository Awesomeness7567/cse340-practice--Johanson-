<%- include("../partials/header") %>

<main>
  <h1><%= faculty.name %></h1>
  <img class="faculty-image faculty-profile-image" src="/images/faculty/<%= faculty.slug %>.jpg" alt="Portrait of <%= faculty.name %>" onerror="this.classList.add('image-missing')">

  <section class="faculty-details">
    <p><strong>Title:</strong> <%= faculty.title %></p>
    <p><strong>Department:</strong> <%= faculty.department %></p>
    <p><strong>Office:</strong> <%= faculty.office %></p>
    <p><strong>Phone:</strong> <%= faculty.phone %></p>
    <p>
      <strong>Email:</strong>
      <a href="mailto:<%= faculty.email %>">
        <%= faculty.email %>
      </a>
    </p>
  </section>

  <a href="/faculty">Back to Faculty Directory</a>
</main>

<%- include("../partials/footer") %>
